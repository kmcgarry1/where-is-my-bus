{
  "name": "bustime",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:api && vue-tsc -b && vite build",
    "build:api": "esbuild api/_handler.ts --bundle --platform=node --target=node20 --format=cjs --outfile=api/index.cjs",
    "preview": "vite preview",
    "test:eta": "node --test tests/etaPredictor.test.mjs",
    "test:history": "node --test tests/historyStore.test.mjs",
    "test:transit": "node --test tests/transitQuery.test.mjs tests/delayAssessment.test.mjs tests/transitStatic.test.mjs",
    "smoke": "node scripts/smoke.mjs",
    "verify:nta": "node scripts/verify-nta.mjs"
  },
  "dependencies": {
    "@lucide/vue": "^1.45.0",
    "@mapbox/maki": "^8.2.0",
    "@turf/bbox": "^7.4.0",
    "@turf/helpers": "^7.4.0",
    "adm-zip": "^0.6.0",
    "gtfs-realtime-bindings": "^2.2.0",
    "mapbox-gl": "^3.29.0",
    "maplibre-gl": "^6.9.0",
    "proj4": "^2.22.0",
    "uplot": "^1.6.32",
    "vue": "^3.5.41",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "esbuild": "^0.28.2",
    "playwright": "^1.62.1",
    "typescript": "~6.0.2",
    "vercel": "^59.16.0",
    "vite": "^8.2.2",
    "vue-tsc": "^3.3.11"
  }
}
