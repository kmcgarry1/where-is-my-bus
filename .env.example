# Optional public Mapbox token. Leave blank for the OpenStreetMap fallback.
VITE_MAPBOX_ACCESS_TOKEN=

# Server-only NTA/TFI GTFS-Realtime access.
NTA_API_KEY=
NTA_VEHICLE_POSITIONS_URL=
NTA_TRIP_UPDATES_URL=
NTA_SERVICE_ALERTS_URL=

# Optional public static GTFS ZIP used to enrich realtime vehicles and alerts.
# If omitted, BusTime uses the current TFI realtime-aligned feed.
# Current realtime-aligned feed:
# https://www.transportforireland.ie/transitData/Data/GTFS_Realtime.zip
NTA_GTFS_STATIC_URL=
NTA_DISABLE_RECOMMENDED_STATIC_GTFS=
